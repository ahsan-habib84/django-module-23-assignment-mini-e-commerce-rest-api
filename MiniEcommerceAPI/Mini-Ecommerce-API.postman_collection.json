{
  "info": {
    "name": "Mini E-commerce REST API",
    "_postman_id": "mini-ecommerce-drf",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"ahsan\",\"email\":\"ahsan@example.com\",\"password\":\"12345678\",\"password2\":\"12345678\"}"
        },
        "url": "{{base_url}}/auth/register/"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"ahsan\",\"password\":\"12345678\"}"
        },
        "url": "{{base_url}}/auth/login/"
      }
    },
    {
      "name": "List Products",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/products/"
      }
    },
    {
      "name": "Search Products",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/products/?search=phone"
      }
    },
    {
      "name": "Order - Authenticated",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"product\":1,\"quantity\":2}"
        },
        "url": "{{base_url}}/orders/"
      }
    }
  ]
}